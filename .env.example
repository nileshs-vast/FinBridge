# Copy to .env: `cp .env.example .env`

# --- Database ---
POSTGRES_USER=finbridge
POSTGRES_PASSWORD=finbridge
POSTGRES_DB=finbridge
# Used by the app container (postgres hostname = compose service name).
DATABASE_URL=postgresql+psycopg://finbridge:finbridge@postgres:5432/finbridge

# --- Auth ---
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- File storage ---
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=10485760

# --- AI extraction ---
# fixture | claude | gemini
EXTRACTION_PROVIDER=fixture

# Optional; required only when EXTRACTION_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Optional; required only when EXTRACTION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
